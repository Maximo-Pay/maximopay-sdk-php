{
  "name": "maximopay/maximopay-php",
  "description": "SDK do Máximo Pay para PHP: cobranças, saques e webhooks assinados.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "MaximoPay\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "MaximoPay\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
